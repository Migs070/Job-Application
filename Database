-- Create Database
CREATE DATABASE IF NOT EXISTS job_application_db;
USE job_application_db;

-- Create Table for Senior Full Stack Software Engineer Applications
CREATE TABLE IF NOT EXISTS job_applications (
    applicant_id INT AUTO_INCREMENT PRIMARY KEY,
    first_name VARCHAR(100) NOT NULL,
    last_name VARCHAR(100) NOT NULL,
    email VARCHAR(150) NOT NULL,
    phone_number VARCHAR(20) NOT NULL,
    years_experience INT NOT NULL,
    primary_tech_stack VARCHAR(255) NOT NULL,
    portfolio_url VARCHAR(255) NOT NULL,
    date_added TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);
